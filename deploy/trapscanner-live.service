[Unit]
Description=NiftyTrapScanner — Live Tracker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/trapscanner
EnvironmentFile=/opt/trapscanner/.env
ExecStart=/opt/trapscanner/.venv/bin/streamlit run live_tracker.py \
    --server.port=8501 \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --server.enableCORS=false
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
